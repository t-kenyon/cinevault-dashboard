# Default demo mode. Enable only after approving public server/inventory totals.
CINEVAULT_DATA_MODE=demo
# Server-only runtime values; never prefix these with NEXT_PUBLIC_.
TAUTULLI_URL=
TAUTULLI_API_KEY=
# Tautulli 2.18+ is required for X-Api-Key header authentication.
# Member analytics require separate consent and a private read-only runtime mount.
# CINEVAULT_CONSENT_FILE=/run/cinevault/consent.json
# Personal analytics are opt-in separately from server status/inventory.
CINEVAULT_MEMBER_ANALYTICS=0
# Optional self-hosted custom member photos. Use the exact public HTTPS origin.
# CINEVAULT_PUBLIC_URL=https://your-dashboard.example
# CINEVAULT_PHOTO_DIR=/run/cinevault/member-photos
